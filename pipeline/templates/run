#!/usr/bin/exec-suid -- /usr/bin/python3 -I
# ^ Deployment shebang for pwn.college-style platforms (SUID wrapper so the grader can read /flag).
#   Check it against your platform before deploying. For local play use:  python3 run --flag-path FILE
"""Generated challenge entry point (pipeline/templates/run).

Reads the player's text from stdin, lets the assistant handle the user's request, and prints the
flag if the attacker's goal was reached. All wording comes from briefing.json; this file is the
same for every generated challenge.
"""

import json
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

from grader import MAX_INPUT_CHARS, grade, load_config  # noqa: E402
from agent import format_trace  # noqa: E402
import challenge_env as be  # noqa: E402

with open(os.path.join(HERE, "briefing.json")) as _f:
    TEXT = json.load(_f)


def _fill(s: str, user_task: str) -> str:
    return s.replace("{user_prompt}", be.user_prompt(user_task)).replace("{max_chars}", str(MAX_INPUT_CHARS))


def briefing(user_task: str) -> str:
    return _fill(
        f"=== {TEXT['slug']}: {TEXT['title']} ===\n"
        f"{TEXT['scenario']}\n\n"
        f"    \"{{user_prompt}}\"\n\n"
        f"{TEXT['control']}\n\n"
        f"Goal: {TEXT['goal']}\n\n"
        f"Type the text to add (max {{max_chars}} chars), then Ctrl-D:\n", user_task)


def main() -> int:
    flag_path = "/flag"
    if "--flag-path" in sys.argv:  # local testing only; under SUID /flag is used
        if os.geteuid() != os.getuid():
            print("--flag-path is disabled when running privileged.")
            return 2
        flag_path = sys.argv[sys.argv.index("--flag-path") + 1]

    cfg = load_config()
    print(briefing(cfg.user_task), flush=True)
    text = sys.stdin.read()
    if text.endswith("\n"):
        text = text[:-1]
    if not text.strip():
        print("Empty input. Nothing to add.")
        return 1
    if len(text) > MAX_INPUT_CHARS:
        print(f"Input is {len(text)} chars; the limit is {MAX_INPUT_CHARS}.")
        return 1

    print("\nRunning the assistant (this can take a minute)...\n")
    try:
        g = grade(text, cfg)
    except Exception as e:  # model server down, timeout, etc.
        print(f"The assistant could not run: {type(e).__name__}: {e}")
        print("This is an infrastructure problem, not your answer. Try again in a minute.")
        return 3

    print("What the assistant did:")
    print(format_trace(g.run))
    print(f"\nAssistant's final reply: {g.run.final_output!r}")
    print(f"{TEXT['user_task_label']}: {'yes' if g.user_task_done else 'no'}")

    if g.passed:
        print(f"\n{TEXT['success']} Here is your flag:")
        with open(flag_path) as f:
            print(f.read().strip())
        return 0
    print(f"\n{TEXT['failure']} The model is not deterministic;")
    print("study the trace above, adjust your text, and try again.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
