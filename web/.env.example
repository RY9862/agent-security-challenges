# Copy to web/.env and fill in. The NRP key does NOT go here: put it in web/secrets/nrp_key.

# Players need this to create an account. Share it with the lab, not publicly.
ASC_INVITE_CODE=change-me

# Comma-separated usernames that can see the Admin page (all attempts, stats, export).
ASC_ADMINS=

# Models players can choose from; the first is the default. Names as NRP lists them
# (python3 scripts/check.py lists them and checks they can call tools).
ASC_MODELS=gpt-oss,gemma-small

# How many runs go to the model at once. NRP limits parallel requests per key, and
# every player's runs use the same key, so keep this small.
ASC_MAX_CONCURRENT=2

# Runs per player per hour (admins are exempt).
ASC_HOURLY_LIMIT=40

# OpenAI-compatible endpoint. Default is NRP.
# ASC_BASE_URL=https://ellm.nrp-nautilus.io/v1
